[Unit]
Description=Ledgr FastAPI Backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/ledgr/backend
Environment="PATH=/home/ubuntu/ledgr/backend/.venv/bin"
EnvironmentFile=/home/ubuntu/ledgr/backend/.env
ExecStart=/home/ubuntu/ledgr/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
